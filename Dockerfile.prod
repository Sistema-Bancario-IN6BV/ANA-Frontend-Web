# --- Fase 8: imagen de producción de ANA-Frontend-Web (multi-stage) ---

# ---- Etapa 1: "build" — compila los estáticos con Vite ----
FROM node:22-slim AS build

WORKDIR /usr/src/app

RUN corepack enable && corepack prepare pnpm@10.30.0 --activate

COPY package.json pnpm-lock.yaml ./

# Aquí SÍ instalamos devDependencies (vite, tailwind, @vitejs/plugin-react
# viven ahí) — se necesitan para construir, aunque no para servir el
# resultado. Por eso no se usa --prod en esta etapa.
RUN pnpm install --frozen-lockfile

COPY . .

# Vite incrusta las variables VITE_* en el JS del bundle en tiempo de BUILD,
# no de runtime — por eso entra como ARG (parámetro de build), no como
# variable de entorno del contenedor final. Nginx, después, no sabe ni le
# importa qué URL de API se usó.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm build

# ---- Etapa 2: "runtime" — Nginx sirviendo los estáticos ya compilados ----
FROM nginx:1.27-alpine AS runtime

COPY --from=build /usr/src/app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
